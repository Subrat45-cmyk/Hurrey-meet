# Server Configuration
PORT=3000
NODE_ENV=development

# STUN Servers (comma-separated)
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302

# TURN Server Configuration (Optional for local testing, mandatory for strict symmetric NAT / cross-network)
# Multiple URLs can be separated by commas (supports UDP, TCP, and TLS)
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
TURN_USERNAME=hurrey_user
TURN_CREDENTIAL=hurrey_secure_password

# Ephemeral TURN Shared Secret (Optional - for RFC 5766 time-limited credentials)
# If provided, the server will compute dynamic time-limited credentials for participants.
TURN_SECRET=
TURN_TTL_SECONDS=86400

# CORS / Origin Configuration
ALLOWED_ORIGINS=*
